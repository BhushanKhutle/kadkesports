{
  "title": "Kadke Sports — Platform Overview",
  "uid": "kadke-overview",
  "schemaVersion": 38,
  "version": 1,
  "tags": ["kadke", "ecommerce"],
  "time": { "from": "now-6h", "to": "now" },
  "refresh": "30s",
  "panels": [
    {
      "id": 1, "type": "stat", "title": "API Request Rate (req/s)",
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 0 },
      "targets": [{ "expr": "sum(rate(http_requests_total{job=\"kadke-backend\"}[5m]))", "refId": "A" }],
      "fieldConfig": { "defaults": { "unit": "reqps", "color": { "mode": "thresholds" }, "thresholds": { "steps": [{ "color": "green", "value": 0 }, { "color": "yellow", "value": 100 }, { "color": "red", "value": 500 }] } } }
    },
    {
      "id": 2, "type": "stat", "title": "Error Rate (%)",
      "gridPos": { "h": 4, "w": 6, "x": 6, "y": 0 },
      "targets": [{ "expr": "100 * sum(rate(http_requests_total{job=\"kadke-backend\",status=~\"5..\"}[5m])) / sum(rate(http_requests_total{job=\"kadke-backend\"}[5m]))", "refId": "A" }],
      "fieldConfig": { "defaults": { "unit": "percent", "thresholds": { "steps": [{ "color": "green", "value": 0 }, { "color": "yellow", "value": 1 }, { "color": "red", "value": 5 }] } } }
    },
    {
      "id": 3, "type": "stat", "title": "p95 Latency (ms)",
      "gridPos": { "h": 4, "w": 6, "x": 12, "y": 0 },
      "targets": [{ "expr": "histogram_quantile(0.95, sum(rate(http_request_duration_seconds_bucket{job=\"kadke-backend\"}[5m])) by (le)) * 1000", "refId": "A" }],
      "fieldConfig": { "defaults": { "unit": "ms" } }
    },
    {
      "id": 4, "type": "stat", "title": "Active Pods",
      "gridPos": { "h": 4, "w": 6, "x": 18, "y": 0 },
      "targets": [{ "expr": "count(up{job=\"kadke-backend\"} == 1)", "refId": "A" }]
    },
    {
      "id": 5, "type": "timeseries", "title": "Requests per second by status",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 4 },
      "targets": [{ "expr": "sum(rate(http_requests_total{job=\"kadke-backend\"}[1m])) by (status)", "refId": "A", "legendFormat": "{{status}}" }]
    },
    {
      "id": 6, "type": "timeseries", "title": "Latency percentiles",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 4 },
      "targets": [
        { "expr": "histogram_quantile(0.50, sum(rate(http_request_duration_seconds_bucket{job=\"kadke-backend\"}[5m])) by (le))", "refId": "A", "legendFormat": "p50" },
        { "expr": "histogram_quantile(0.95, sum(rate(http_request_duration_seconds_bucket{job=\"kadke-backend\"}[5m])) by (le))", "refId": "B", "legendFormat": "p95" },
        { "expr": "histogram_quantile(0.99, sum(rate(http_request_duration_seconds_bucket{job=\"kadke-backend\"}[5m])) by (le))", "refId": "C", "legendFormat": "p99" }
      ]
    },
    {
      "id": 7, "type": "timeseries", "title": "Pod CPU / Memory",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 12 },
      "targets": [
        { "expr": "rate(container_cpu_usage_seconds_total{namespace=\"kadke\",pod=~\".*backend.*\"}[5m])", "refId": "A", "legendFormat": "{{pod}} cpu" },
        { "expr": "container_memory_working_set_bytes{namespace=\"kadke\",pod=~\".*backend.*\"}", "refId": "B", "legendFormat": "{{pod}} mem" }
      ]
    },
    {
      "id": 8, "type": "timeseries", "title": "Logs error rate (Loki)",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 12 },
      "datasource": { "type": "loki", "uid": "loki" },
      "targets": [{ "expr": "sum(rate({app=\"backend\"} |= \"ERROR\"[5m]))", "refId": "A" }]
    }
  ]
}
